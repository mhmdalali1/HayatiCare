# Copy this file to .env in the project root. NEVER commit .env.
# Set each value for your own local MySQL instance.
DB_HOST=localhost
DB_USER=hmss_user
DB_PASSWORD=replace_with_your_local_database_password
DB_NAME=hmss_db

# Generate independent secrets with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_character_hex_string
JWT_SECRET_KEY=replace_with_another_random_64_character_hex_string
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# Optional AI integration (leave unset if not configured).
# OPENAI_API_KEY=replace_with_your_own_key
